<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <MyWebLibCrudOutputFile Condition="'$(MyWebLibCrudOutputFile)' == ''">$(MSBuildProjectDirectory)\wwwroot\crud-generated.html</MyWebLibCrudOutputFile>
    <MyWebLibCrudTitle Condition="'$(MyWebLibCrudTitle)' == ''">Generated CRUD page</MyWebLibCrudTitle>
    <MyWebLibCrudControllerUrl Condition="'$(MyWebLibCrudControllerUrl)' == ''">$(ControllerUrl)</MyWebLibCrudControllerUrl>
  </PropertyGroup>

  <UsingTask
    TaskName="GenerateCrudHtmlTask"
    TaskFactory="RoslynCodeTaskFactory"
    AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <ControllerUrl ParameterType="System.String" Required="true" />
      <OutputFile ParameterType="System.String" Required="true" />
      <PageTitle ParameterType="System.String" Required="false" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        var targetDirectory = Path.GetDirectoryName(OutputFile);
        if (!string.IsNullOrWhiteSpace(targetDirectory))
        {
            Directory.CreateDirectory(targetDirectory);
        }

        var safeTitle = string.IsNullOrWhiteSpace(PageTitle) ? "Generated CRUD page" : PageTitle;
        var endpoint = ControllerUrl.Replace("\\", "\\\\").Replace("\"", "\\\"");

        var html = $@"<!DOCTYPE html>
<html lang=\"en\">
<head>
  <meta charset=\"UTF-8\" />
  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />
  <title>{safeTitle}</title>
  <style>
    body {{ font-family: Arial, sans-serif; margin: 2rem; background: #f7f7f9; }}
    h1 {{ margin-top: 0; }}
    .toolbar {{ display: flex; gap: .5rem; flex-wrap: wrap; margin-bottom: 1rem; }}
    input {{ padding: .5rem; border: 1px solid #c5c5cc; border-radius: 6px; }}
    button {{ padding: .5rem .8rem; border: none; border-radius: 6px; cursor: pointer; background: #2563eb; color: #fff; }}
    button:hover {{ background: #1d4ed8; }}
    table {{ width: 100%; border-collapse: collapse; background: #fff; }}
    th, td {{ border: 1px solid #ddd; padding: .6rem; text-align: left; }}
    th {{ background: #f0f4ff; }}
    .note {{ color: #4b5563; font-size: .9rem; margin-bottom: 1rem; }}
  </style>
</head>
<body>
  <h1>{safeTitle}</h1>
  <p class=\"note\">Endpoint: <code>{endpoint}</code></p>

  <div class=\"toolbar\">
    <input id=\"idInput\" type=\"text\" placeholder=\"ID\" />
    <input id=\"payloadInput\" type=\"text\" placeholder='JSON payload, e.g. {{\"name\":\"Test\"}}' size=\"40\" />
    <button onclick=\"loadAll()\">GET all</button>
    <button onclick=\"loadById()\">GET by id</button>
    <button onclick=\"createItem()\">POST</button>
    <button onclick=\"updateItem()\">PUT</button>
    <button onclick=\"deleteItem()\">DELETE</button>
  </div>

  <table>
    <thead>
      <tr>
        <th>#</th>
        <th>Data</th>
      </tr>
    </thead>
    <tbody id=\"resultsBody\"></tbody>
  </table>

  <script>
    const endpoint = \"{endpoint}\";

    const parsePayload = () => {{
      const source = document.getElementById('payloadInput').value.trim();
      if (!source) return {{}};
      return JSON.parse(source);
    }};

    const renderRows = (data) => {{
      const body = document.getElementById('resultsBody');
      const rows = Array.isArray(data) ? data : [data];
      body.innerHTML = rows.map((row, i) => `\n        <tr>\n          <td>${{i + 1}}</td>\n          <td><pre>${{JSON.stringify(row, null, 2)}}</pre></td>\n        </tr>\n      `).join('');
    }};

    const getId = () => document.getElementById('idInput').value.trim();

    async function loadAll() {{
      const response = await fetch(endpoint);
      renderRows(await response.json());
    }}

    async function loadById() {{
      const id = getId();
      if (!id) return alert('Specify ID first');
      const response = await fetch(`${{endpoint}}/${{id}}`);
      renderRows(await response.json());
    }}

    async function createItem() {{
      const response = await fetch(endpoint, {{
        method: 'POST',
        headers: {{ 'Content-Type': 'application/json' }},
        body: JSON.stringify(parsePayload())
      }});
      renderRows(await response.json());
    }}

    async function updateItem() {{
      const id = getId();
      if (!id) return alert('Specify ID first');
      const response = await fetch(`${{endpoint}}/${{id}}`, {{
        method: 'PUT',
        headers: {{ 'Content-Type': 'application/json' }},
        body: JSON.stringify(parsePayload())
      }});
      renderRows(await response.json());
    }}

    async function deleteItem() {{
      const id = getId();
      if (!id) return alert('Specify ID first');
      await fetch(`${{endpoint}}/${{id}}`, {{ method: 'DELETE' }});
      loadAll();
    }}
  </script>
</body>
</html>";

        File.WriteAllText(OutputFile, html);
        Log.LogMessage(MessageImportance.High, $"MyWebLib: CRUD page generated at '{OutputFile}'.");
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="GenerateCrudHtmlPage">
    <Error Condition="'$(MyWebLibCrudControllerUrl)' == ''"
           Text="Set controller url: /p:MyWebLibCrudControllerUrl=https://localhost:5001/api/products" />
    <GenerateCrudHtmlTask Condition="'$(MyWebLibCrudControllerUrl)' != ''"
                          ControllerUrl="$(MyWebLibCrudControllerUrl)"
                          OutputFile="$(MyWebLibCrudOutputFile)"
                          PageTitle="$(MyWebLibCrudTitle)" />
  </Target>
</Project>
